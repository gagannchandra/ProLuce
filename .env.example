# Public site URL, used for canonical URLs, sitemap, and structured metadata.
NEXT_PUBLIC_SITE_URL=https://www.proluce.example

# Inquiry form delivery (optional). Without RESEND_API_KEY, submissions are
# logged to the server console instead of emailed — useful for local dev.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=sales@proluce.example
INQUIRY_FROM_EMAIL=
